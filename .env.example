# Neon: pooled for the app, direct for the Prisma CLI, backups and other admin work
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
APP_URL="http://localhost:3000"
# Generate the real value with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-at-least-32-characters"
# Photo storage: "disk" (public/uploads, dev/test only, refused on Vercel) or "blob". With blob,
# both Blob values are required; the host looks like STOREID.public.blob.vercel-storage.com.
STORAGE_DRIVER="disk"
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_HOST=""
CRON_SECRET=""
NEXT_PUBLIC_APP_NAME="Lendshed"
COMMUNITY_NAME="Elm Street"
# Dev/test only: `npm run db:seed` writes the Elm Street demo people only when this equals the
# host of DATABASE_URL_UNPOOLED (e.g. ep-xxx.REGION.aws.neon.tech). Never set it for production.
DEMO_SEED_DB_HOST=""

# Local-only inputs for `npm run db:bootstrap` (the first organizer). Keep them in a separate
# local file passed with `npx tsx --env-file=<file> scripts/bootstrap-organizer.ts`.
# Never add them to Vercel or to the app's env schema.
# ORGANIZER_NAME="Ruth K."
# ORGANIZER_EMAIL="organizer@example.com"
# ORGANIZER_PASSWORD="at-least-10-characters"
