// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The auth models below come from `npx auth generate --config auth.cli.ts
// --adapter prisma --dialect postgresql --output prisma/schema.prisma`.
// Hand edits that a re-run keeps: the two enums, @@index([role, status]) and
// every @db.Timestamptz(3).

enum Role {
  member
  organizer
}

enum MemberStatus {
  active
  suspended
}

model User {
  id                 String               @id
  name               String
  email              String
  emailVerified      Boolean              @default(false)
  image              String?
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  role               Role                 @default(member)
  status             MemberStatus         @default(active)
  area               String?
  contactDetails     String?
  sessions           Session[]
  accounts           Account[]
  invitationsCreated Invitation[]         @relation("InvitationCreatedBy")
  invitationsUsed    Invitation[]         @relation("InvitationUsedBy")
  resetGrants        PasswordResetGrant[] @relation("PasswordResetGrantUser")
  resetGrantsCreated PasswordResetGrant[] @relation("PasswordResetGrantCreatedBy")
  itemsOwned         Item[]               @relation("ItemOwner")
  itemsRetired       Item[]               @relation("ItemRetiredBy")
  loansBorrowed      Loan[]               @relation("LoanBorrower")
  loansClosed        Loan[]               @relation("LoanClosedBy")
  uploads            UploadLog[]          @relation("UploadLogUser")

  @@unique([email])
  @@index([role, status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// App models below; `npx auth generate` leaves them and the nine User
// relations above untouched (re-run on a scratch copy checked at spec 09).

model Invitation {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  note        String?
  createdById String?
  createdBy   User?     @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  usedById    String?
  usedBy      User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("invitation")
}

model PasswordResetGrant {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("PasswordResetGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation("PasswordResetGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_grant")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  nameKey   String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  items     Item[]

  @@map("category")
}

enum ItemCondition {
  new
  good
  worn
  needs_care
}

enum ItemStatus {
  hidden
  listed
  retired
}

enum LoanStatus {
  requested
  approved
  out
  returned
  declined
  cancelled
  expired
  lapsed
}

enum ReturnedAsLent {
  yes
  no
  unknown
}

enum LoanActor {
  owner
  borrower
  organizer
  system
}

enum LoanSystemReason {
  dates_taken
  item_hidden
  item_retired
  owner_suspended
  borrower_suspended
  account_deleted
}

// CHECK item_maxLoanDays_check (1–30) is hand-written in items_and_loans.

model Item {
  id          String        @id @default(uuid())
  ownerId     String?
  owner       User?         @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String
  description String
  condition   ItemCondition
  maxLoanDays Int           @default(7)
  pickupNotes String?
  status      ItemStatus    @default(hidden)
  listedAt    DateTime?     @db.Timestamptz(3)
  retiredAt   DateTime?     @db.Timestamptz(3)
  retiredNote String?
  retiredById String?
  retiredBy   User?         @relation("ItemRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  photoKey    String?
  photoUrl    String?
  photoWidth  Int?
  photoHeight Int?
  photoBytes  Int?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  loans       Loan[]

  @@index([status, listedAt(sort: Desc)])
  @@index([ownerId])
  @@index([categoryId])
  @@map("item")
}

// CHECK loan_dates_check is hand-written in items_and_loans; the exclusion
// constraint loan_no_overlap in its own migration.

model Loan {
  id             String            @id @default(uuid())
  itemId         String
  item           Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrowerId     String?
  borrower       User?             @relation("LoanBorrower", fields: [borrowerId], references: [id], onDelete: SetNull)
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  status         LoanStatus        @default(requested)
  requestMessage String?
  statusReason   String?
  endedBy        LoanActor?
  systemReason   LoanSystemReason?
  returnedOn     DateTime?         @db.Date
  returnedAsLent ReturnedAsLent?
  closedById     String?
  closedBy       User?             @relation("LoanClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  ownerSeenAt    DateTime?         @db.Timestamptz(3)
  borrowerSeenAt DateTime?         @db.Timestamptz(3)
  changedAt      DateTime          @default(now()) @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([itemId, status])
  @@index([borrowerId, status])
  @@index([itemId, startDate])
  @@map("loan")
}

// One row per member upload, written before the file is stored; counts the
// monthly and daily caps and survives account deletion.
model UploadLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation("UploadLogUser", fields: [userId], references: [id], onDelete: SetNull)
  bytes     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("upload_log")
}

// The outbox: every stored file nothing references (or not yet), queued inside
// the committing transaction and removed once the file is deleted.
model PendingBlobDeletion {
  id         String   @id @default(uuid())
  storageKey String   @unique
  bytes      Int
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@map("pending_blob_deletion")
}
