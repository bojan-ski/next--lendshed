{
  "$description": "Lendshed design tokens (spec section 12). Same values as src/app/globals.css. Format: W3C Design Tokens Community Group draft.",
  "color": {
    "$type": "color",
    "page": { "$value": "#FAF7F2", "$description": "Page background" },
    "card": { "$value": "#FFFFFF", "$description": "Cards, fields, header" },
    "line": { "$value": "#E6E0D6", "$description": "Card and table borders (decorative)" },
    "field": { "$value": "#8C857B", "$description": "Input and outline-button borders; 3.65:1 on card" },
    "ink": { "$value": "#26231F", "$description": "Text; 14.6:1 on page" },
    "muted": { "$value": "#6B655D", "$description": "Secondary text; 5.4:1 on page" },
    "accent": { "$value": "#2F5D46", "$description": "Shed green: main button, links, current place; 7.6:1 with white" },
    "accent-hover": { "$value": "#244A37", "$description": "Main button hover and press" },
    "accent-soft": { "$value": "#E4EEE7", "$description": "Selected states, Approved/Out/Listed/Active labels, initials" },
    "overdue": { "$value": "#C2410C", "$description": "Overdue label only; 5.2:1 with white" },
    "neutral-soft": { "$value": "#EFECE7", "$description": "Requested label, loading placeholders" },
    "done-soft": { "$value": "#F2F0EC", "$description": "Finished, Hidden and Suspended labels" },
    "notice": { "$value": "#F6F1EA", "$description": "Error notice background, with a 3 px ink left border" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Next", "system-ui", "sans-serif"] },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "14px", "$description": "Captions, table meta" },
      "base": { "$value": "16px", "$description": "Body and all form text" },
      "lg": { "$value": "18px", "$description": "Card titles" },
      "xl": { "$value": "22px", "$description": "Section headings" },
      "2xl": { "$value": "28px", "$description": "Page headings" },
      "3xl": { "$value": "36px", "$description": "\"Elm Street\" on Browse" }
    }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": "12px" },
    "control": { "$value": "10px" },
    "label": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "button-height": { "$value": "48px" },
    "touch-target-min": { "$value": "44px" },
    "icon": { "$value": "20px", "$description": "16px inside labels" },
    "icon-stroke": { "$value": "1.75px" },
    "focus-ring": { "$value": "2px", "$description": "accent outline, 2px offset" }
  }
}
